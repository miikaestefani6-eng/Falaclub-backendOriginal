{
  "name": "falaclub-backend",
  "version": "0.3.0",
  "private": true,
  "description": "Backend oficial do FalaClub",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:chat": "tsx scripts/test-chat.ts",
    "test:voice": "tsx scripts/test-voice-chat.ts",
    "test:e2e:render": "ts-node scripts/e2e-render-test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "openai": "^7.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
